#cloud-config
write_files:
  - path: /etc/rclone/rclone.conf
    permissions: '0600'
    content: |
      [s3]
      type = s3
      provider = ${backup_provider}
      access_key_id = ${backup_access_key}
      secret_access_key = ${backup_secret_key}
      region = ${backup_region}
      location_constraint = ${backup_region}
      endpoint = ${backup_endpoint}
      acl = private
      env_auth = false
      upload_cutoff = 5M
      chunk_size = 5M
      copy_cutoff = 5M

  - path: /usr/local/bin/backup-satisfactory.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      echo "Starting backup to S3..."
      docker run --rm \
        -v /etc/rclone/rclone.conf:/config/rclone/rclone.conf \
        -v satisfactory_data:/data \
        rclone/rclone sync /data s3:${backup_bucket} --include "/gamefiles/FactoryGame/Saved/**" --include "/saved/**"
      echo "Backup finished."

runcmd:
  # 1. Create a docker volume
  - docker volume create satisfactory_data
  
  # 2. Run a docker container that syncs the data from an S3 bucket to this volume
  - |
    docker run --rm \
      -v /etc/rclone/rclone.conf:/config/rclone/rclone.conf \
      -v satisfactory_data:/data \
      rclone/rclone sync s3:${backup_bucket} /data

  # 3. After this is finished, start a Satisfactory container
  - |
    docker run \
      --detach \
      --name=satisfactory-server \
      --hostname satisfactory-server \
      --restart unless-stopped \
      --volume satisfactory_data:/config \
      --env MAXPLAYERS=${game_max_players} \
      --memory-reservation=8G \
      --memory 16G \
      --publish 7777:7777/tcp \
      --publish 7777:7777/udp \
      --publish 8888:8888/tcp \
      ${game_image}

  # 4. Run another container that periodically backs up (via cron)
  - (crontab -l 2>/dev/null; echo "${backup_cron_schedule} /usr/local/bin/backup-satisfactory.sh >> /var/log/satisfactory-backup.log 2>&1") | crontab -
